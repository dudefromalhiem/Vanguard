# Environment Variables
# Copy to .env and fill in values, or set in Vercel project settings.

# Admin credentials — JSON object mapping email to password
# Example: {"admin@nie.ac.in":"securepass1","faculty@nie.ac.in":"securepass2"}
ADMIN_CREDENTIALS=

# Secret for signing admin JWT sessions (min 32 characters)
ADMIN_SESSION_SECRET=

# Supabase project credentials (from Settings > API in Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (optional — for email notifications)
# Get from https://resend.com/api-keys
RESEND_API_KEY=
